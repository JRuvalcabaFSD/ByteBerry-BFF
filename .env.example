# ========================================
# ByteBerry BFF (Backend for Frontend) - Environment Variables
# ========================================
# Version: F2 - Sky Island Saga (Persistencia + Management)
# Last Updated: January 2026
# ========================================

# ========================================
# 🔧 APPLICATION CONFIG (F0+)
# ========================================

# Node Environment
# Valores: development | production | test
NODE_ENV=development

# Server Port
# BFF escucha en puerto 4002 internamente
PORT=4002

# Service Name
# Nombre del servicio para logs y monitoreo
SERVICE_NAME=ByteBerry-BFF

# Service URL
# URL base del servicio (sin puerto, sin trailing slash)
SERVICE_URL=http://localhost


# ========================================
# 📝 LOGGING CONFIG (F0+)
# ========================================

# Log Level
# Valores: error | warn | info | debug
# NOTA: NO usar 'debug' en producción
LOG_LEVEL=info

# Log Requests
# Registrar todas las peticiones HTTP entrantes
# NOTA: NO habilitar en producción (performance + privacidad)
LOG_REQUESTS=true


# ========================================
# 🔒 SECURITY CONFIG (F0+)
# ========================================

# CORS Allowed Origins
# Lista separada por comas de orígenes permitidos
# Development:
CORS_ORIGINS=http://localhost:5173,http://localhost:4003,http://localhost:4002
# Production:
# CORS_ORIGINS=https://byteberry.jrmdev.org


# ========================================
# 🚀 EXTERNAL SERVICES (F1+)
# ========================================

# OAuth2 Service URL
# URL interna del servicio OAuth2 (para comunicación entre servicios)
OAUTH2_SERVICE_URL=http://oauth2-service:4000


# ========================================
# 🔑 BFF OAUTH2 CLIENT (F1+)
# ========================================

# BFF Client ID
# ID del cliente de sistema registrado en OAuth2 service
BFF_CLIENT_ID=bff-system-client

# BFF Client Secret
# Secret del cliente de sistema (CAMBIAR EN PRODUCCIÓN)
# Generar con: openssl rand -base64 32
BFF_CLIENT_SECRET=supersecretbffclientsecret

# BFF Redirect URI
# URI de callback después del flujo OAuth2
# Development:
BFF_REDIRECT_URI=http://localhost:4002/auth/callback
# Production:
# BFF_REDIRECT_URI=https://byteberry.jrmdev.org/auth/callback


# ========================================
# 🔐 JWT VALIDATION CONFIG (F1+)
# ========================================

# JWT Issuer
# Quien emite el token - debe coincidir con OAuth2 service
JWT_ISSUER=https://byteberry.jrmdev.org

# JWT Audience
# Para quién es el token - puede ser lista separada por comas
JWT_AUDIENCE=byteberry-bff

# JWKS URL
# Endpoint público donde obtener las llaves públicas para validar JWTs
# Development:
JWKS_URL=http://oauth2-service:4000/.well-known/jwks.json
# Production:
# JWKS_URL=https://byteberry.jrmdev.org/auth/.well-known/jwks.json

# JWKS Cache TTL (segundos)
# Tiempo que se cachean las llaves públicas antes de refrescar
JWKS_CACHE_TTL=3600

# JWKS Cache Max Age (segundos)
# Tiempo máximo antes de forzar refresh del JWKS
JWKS_CACHE_MAX_AGE=86400


# ========================================
# 🍪 SESSION & COOKIE CONFIG (F2+)
# ========================================

# Session Cookie Name
# Nombre de la cookie que almacena el session ID
SESSION_COOKIE_NAME=byteberry_session

# Session Secret
# Secret para firmar cookies de sesión (CAMBIAR EN PRODUCCIÓN)
# Generar con: openssl rand -base64 32
# DEBE tener al menos 32 caracteres en producción
SESSION_SECRET=your-super-secret-session-signing-key-change-in-production

# Session Max Age (milliseconds)
# Tiempo de vida de la sesión
# 604800000 = 7 días (7 * 24 * 60 * 60 * 1000)
SESSION_MAX_AGE=604800000

# Cookie Secure Flag
# true = Solo enviar cookie por HTTPS (OBLIGATORIO en producción)
# false = Permitir HTTP (solo development)
COOKIE_SECURE=false

# Cookie HttpOnly Flag
# true = Cookie no accesible desde JavaScript (protección XSS)
# SIEMPRE debe ser true
COOKIE_HTTP_ONLY=true

# Cookie SameSite Attribute
# Valores: strict | lax | none
# - strict: Cookie solo en same-site requests (más seguro)
# - lax: Cookie en top-level navigation + same-site (recomendado)
# - none: Cookie en todos los contextos (requiere Secure=true)
COOKIE_SAME_SITE=lax

# Cookie Domain
# Dominio para la cookie
# Development:
COOKIE_DOMAIN=localhost
# Production:
# COOKIE_DOMAIN=byteberry.jrmdev.org


# ========================================
# 🔐 PKCE CONFIG (F2+)
# ========================================

# PKCE State TTL (segundos)
# Tiempo de vida del code_verifier en memoria
# 600 = 10 minutos
PKCE_STATE_TTL=600


# ========================================
# 🔄 HTTP CLIENT CONFIG (F1+)
# ========================================

# HTTP Max Retries
# Número de reintentos para peticiones fallidas a servicios downstream
HTTP_MAX_RETRIES=3

# HTTP Retry Delay (milliseconds)
# Delay base entre reintentos (usa exponential backoff)
HTTP_RETRY_DELAY=1000


# ========================================
# 📊 NOTAS DE PRODUCCIÓN
# ========================================
#
# ANTES DE DEPLOYMENT A PRODUCCIÓN:
#
# 1. ✅ Cambiar NODE_ENV=production
# 2. ✅ Cambiar LOG_LEVEL=info (NUNCA debug)
# 3. ✅ Cambiar LOG_REQUESTS=false
# 4. ✅ Generar nuevo SESSION_SECRET (32+ caracteres)
# 5. ✅ Generar nuevo BFF_CLIENT_SECRET
# 6. ✅ Configurar COOKIE_SECURE=true (requiere HTTPS)
# 7. ✅ Actualizar CORS_ORIGINS con dominios de producción
# 8. ✅ Actualizar BFF_REDIRECT_URI con URL de producción
# 9. ✅ Actualizar JWKS_URL con URL pública de producción
# 10. ✅ Actualizar COOKIE_DOMAIN con dominio de producción
#
# ========================================
