# ========================================
# ByteBerry BFF (Backend for Frontend) - Environment Variables
# ========================================

# ========================================
# 🔧 APPLICATION CONFIG (F0+)
# ========================================

# Node Environment
# Valores: development | production | test
NODE_ENV=development

# Server Port
# BFF escucha en puerto 4002 internamente
PORT=4002

# Service Name
# Nombre del servicio para logs y monitoreo
SERVICE_NAME=ByteBerry-BFF

# Service URL
# URL pública del BFF (sin puerto)
SERVICE_URL=http://localhost


# ========================================
# 📝 LOGGING CONFIG (F0+)
# ========================================

# Log Level
# Valores: error | warn | info | debug | trace
LOG_LEVEL=debug

# Log Requests (registrar todas las peticiones HTTP)
LOG_REQUESTS=true


# ========================================
# 🔐 JWT VALIDATION CONFIG (F1+)
# ========================================

# JWT Issuer (quien emite el token - debe coincidir con OAuth2)
# Debe ser la URL del servicio OAuth2
JWT_ISSUER=https://byteberry.jrmdev.org

# JWT Audience (para quién es el token - validación)
# BFF valida tokens para el API
JWT_AUDIENCE=byteberry-bff,byteberry-api

# JWKS Cache TTL (tiempo en segundos)
# Tiempo que se cachean las llaves públicas antes de refrescar
JWKS_CACHE_TTL=3600

# JWKS Cache Max Age (tiempo máximo en segundos)
# Tiempo máximo antes de forzar refresh del JWKS
JWKS_CACHE_MAX_AGE=86400


# ========================================
# 🔒 SECURITY CONFIG (F0+)
# ========================================

# CORS Allowed Origins
# Lista separada por comas de orígenes permitidos
# Development:
CORS_ORIGINS=http://localhost:5173,http://localhost:4003
# Production:
# CORS_ORIGINS=https://byteberry.jrmdev.org

# CORS Allowed Methods
CORS_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS

# CORS Allowed Headers
CORS_HEADERS=Content-Type,Authorization,X-Request-ID

# CORS Max Age (seconds)
CORS_MAX_AGE=86400

# Rate Limiting (requests per window)
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX_REQUESTS=100


# ========================================
# 🚀 EXTERNAL SERVICES (F1+)
# ========================================

# OAuth2 Service URL
# URL interna del servicio OAuth2
OAUTH2_SERVICE_URL=http://oauth2-service:4000

# OAuth2 JWKS Endpoint
# URL pública donde obtener las llaves públicas para validar JWT
OAUTH2_JWKS_URL=https://byteberry.jrmdev.org/auth/.well-known/jwks.json
#
# Development (local sin proxy):
# OAUTH2_JWKS_URL=http://localhost:4000/.well-known/jwks.json

# Expenses API URL (F2+)
# URL interna del servicio de Expenses
EXPENSES_SERVICE_URL=http://expenses-service:4001

# Frontend URL
# URL pública del frontend (para redirects si necesario)
FRONTEND_URL=https://byteberry.jrmdev.org
#
# Development:
# FRONTEND_URL=http://localhost:5173


# ========================================
# 🔄 HTTP CLIENT CONFIG (F1+)
# ========================================

# Request Timeout (milliseconds)
# Timeout para peticiones a servicios downstream
HTTP_REQUEST_TIMEOUT=10000

# Retry Configuration
# Número de reintentos para peticiones fallidas
HTTP_MAX_RETRIES=3

# Retry Delay (milliseconds)
# Delay entre reintentos
HTTP_RETRY_DELAY=1000

# Connection Pool Settings
# Número máximo de sockets abiertos por host
HTTP_MAX_SOCKETS=50

# Keep Alive Timeout (milliseconds)
HTTP_KEEP_ALIVE_TIMEOUT=30000


# ========================================
# 🛡️ CIRCUIT BREAKER CONFIG (F8+)
# ========================================

# Circuit Breaker Threshold
# Número de fallos antes de abrir el circuit breaker
# CIRCUIT_BREAKER_THRESHOLD=5

# Circuit Breaker Timeout (milliseconds)
# Tiempo que el circuit permanece abierto antes de intentar recuperarse
# CIRCUIT_BREAKER_TIMEOUT=60000

# Circuit Breaker Rolling Window (milliseconds)
# Ventana de tiempo para contar errores
# CIRCUIT_BREAKER_WINDOW=10000


# ========================================
# 💾 REDIS CONFIG (F6+)
# ========================================

# Redis Connection URL
# Para cache y sesiones compartidas
# REDIS_URL=redis://localhost:6379
# REDIS_PASSWORD=
# REDIS_DB=0


# ========================================
# 📊 MONITORING CONFIG (F0+)
# ========================================

# Health Check Interval (milliseconds)
# Intervalo para verificar salud de dependencias
HEALTH_CHECK_INTERVAL=30000

# Health Check Timeout (milliseconds)
# Timeout para health checks de dependencias
HEALTH_CHECK_TIMEOUT=5000

# Dependencies Health Checks
# Habilitar health checks de servicios downstream
HEALTH_CHECK_OAUTH2=true
HEALTH_CHECK_EXPENSES=true
